<?xml version="1.0" encoding="utf-8"?>
<!--
    FIXED: allow cleartext (ws://) for ALL common private/LAN IP ranges used during dev/deploy.
    Production deployments should use wss:// and remove or restrict this config.
-->
<network-security-config>

    <!-- 10.x.x.x — common carrier NAT / corporate VPN / Android emulator (10.0.2.x) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">10.0.1.1</domain>
        <domain includeSubdomains="true">10.1.0.1</domain>
        <domain includeSubdomains="true">10.10.0.1</domain>
        <domain includeSubdomains="true">10.100.0.1</domain>
    </domain-config>

    <!-- 192.168.x.x — home / office LAN -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
        <domain includeSubdomains="true">192.168.0.100</domain>
        <domain includeSubdomains="true">192.168.2.1</domain>
        <domain includeSubdomains="true">192.168.10.1</domain>
        <domain includeSubdomains="true">192.168.100.1</domain>
        <domain includeSubdomains="true">192.168.50.1</domain>
    </domain-config>

    <!-- 172.16.x.x – 172.31.x.x — docker, corporate -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">172.16.0.1</domain>
        <domain includeSubdomains="true">172.17.0.1</domain>
        <domain includeSubdomains="true">172.20.0.1</domain>
    </domain-config>

    <!-- localhost / loopback (useful for emulator testing) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Everything else: TLS only, trust system CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
